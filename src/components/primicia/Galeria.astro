---
// src/components/primicia/Galeria.astro
// Fotos que pasan solas con un fundido y un zoom lento, ocupando todo el
// recuadro que la contiene (el padre tiene que tener position: relative).
export interface Props {
    fotos: string[];
}
const { fotos } = Astro.props;
---

<div class="galeria" aria-hidden="true">
    {
        fotos.map((foto, i) => (
            <div class:list={["diapositiva", { activa: i === 0 }]} style={`--foto:url('${foto}')`} />
        ))
    }
</div>

<style>
    .galeria {
        position: absolute;
        inset: 0;
        overflow: hidden;
    }

    .diapositiva {
        position: absolute;
        inset: 0;
        background: var(--foto) center center / cover no-repeat;
        opacity: 0;
        transform: scale(1);
        transition:
            opacity 1s ease,
            transform 20s linear;
    }

    .diapositiva.activa {
        opacity: 1;
        transform: scale(1.3);
    }
</style>

<script>
    // Cada foto queda 1 s y se funde en 1 s, como en la plantilla
    document.querySelectorAll<HTMLElement>(".galeria").forEach((galeria) => {
        const diapositivas = [...galeria.querySelectorAll<HTMLElement>(".diapositiva")];
        if (diapositivas.length < 2) return;
        let actual = 0;
        setInterval(() => {
            const anterior = diapositivas[actual];
            actual = (actual + 1) % diapositivas.length;
            diapositivas[actual].classList.add("activa");
            anterior.classList.remove("activa");
        }, 2000);
    });
</script>
