---
// src/components/primicia/Lugares.astro
// "¿Dónde será?": la ceremonia y la recepción, cada una en su recuadro con
// la foto en gris y el botón al mapa.
import { ceremonia, recepcion, soloAdultos } from "../../datos/boda";
---

<section class="lugares">
    <div class="caja relleno">
        <div class="banda">
            <p data-entrada>Únete a nosotros para celebrar una unión de amor risas y felicidad</p>
        </div>
    </div>

    <div class="caja cuerpo">
        <h2 class="titulo">¿Dónde será?</h2>
        <svg class="pin icono-sacudir" viewBox="0 0 64 70" aria-hidden="true">
            <path d="M32 4C20 4 11 13 11 25c0 16 21 37 21 37s21-21 21-37C53 13 44 4 32 4z" />
            <circle cx="32" cy="25" r="8" />
            <path d="M40 66h10" />
        </svg>

        <!-- Ceremonia: el nombre del lugar va en la banda sobre la foto -->
        <article class="tarjeta" data-entrada>
            <div class="col-foto">
                <div class="banda"><p data-entrada>{ceremonia.lugar}</p></div>
                <div class="foto" style={`--foto:url('${ceremonia.foto}')`}></div>
            </div>
            <div class="col-texto">
                <p class="detalle" data-entrada>
                    <strong>| {ceremonia.hora} | {ceremonia.titulo},</strong>
                    <span class="block">{ceremonia.lugar}. {ceremonia.direccion}</span>
                </p>
                <a class="boton" data-entrada href={ceremonia.mapa} target="_blank" rel="noopener noreferrer">
                    Ver ubicación
                </a>
            </div>
        </article>

        <!-- Recepción: el título va en la columna del texto -->
        <article class="tarjeta tarjeta-arriba" data-entrada>
            <div class="col-foto">
                <div class="foto" style={`--foto:url('${recepcion.foto}')`}></div>
            </div>
            <div class="col-texto">
                <h3 class="subtitulo" data-entrada>{recepcion.titulo}</h3>
                <p class="detalle" data-entrada>
                    <strong>| {recepcion.hora} | {recepcion.lugar}</strong>
                    <span class="block">{recepcion.direccion}</span>
                </p>
                <a class="boton" data-entrada href={recepcion.mapa} target="_blank" rel="noopener noreferrer">
                    Ver ubicación
                </a>
            </div>
        </article>

        {
            soloAdultos.mostrar && (
                <div class="ninos" data-entrada>
                    <img class="icono-sacudir" src="/iconos/restriccion.png" alt="" loading="lazy" />
                    <p data-entrada>{soloAdultos.texto}</p>
                </div>
            )
        }
    </div>
</section>

<style>
    .lugares {
        border-top: 1px solid #000;
        border-bottom: 1px solid #000;
        padding: 0 10px;
    }

    .relleno {
        padding: 10px;
    }

    .banda {
        padding: 10px;
        background-color: #000;
        color: #fff;
        font-size: 16px;
        line-height: 27.2px;
        text-transform: uppercase;
        text-align: center;
    }

    .cuerpo {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        padding: 10px;
    }

    .titulo {
        font-size: 30px;
        font-weight: 700;
        line-height: 30px;
        color: #000;
    }

    .pin {
        width: 100px;
        height: 108px;
        fill: none;
        stroke: #000;
        stroke-width: 1.6;
        stroke-linecap: round;
    }

    /* ── Recuadros de cada lugar ───────────────────────────── */
    .tarjeta {
        display: flex;
        align-items: center;
        gap: 20px;
        width: 100%;
        padding: 10px;
        border: 3px solid #1b1a1c;
    }

    .tarjeta-arriba {
        align-items: flex-start;
    }

    .col-foto {
        display: flex;
        flex-direction: column;
        gap: 20px;
        flex: 0 0 31.6%;
        padding: 10px;
    }

    .foto {
        min-height: 300px;
        background: var(--foto) center center / cover no-repeat;
        filter: saturate(0%);
    }

    .col-texto {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
        gap: 20px;
        min-width: 0;
        padding: 10px;
    }

    .subtitulo {
        font-family: "Times New Roman", Times, serif;
        font-size: 30px;
        font-weight: 700;
        line-height: 27.2px;
        color: #000;
    }

    .detalle {
        font-size: 18px;
        line-height: 1.2em;
        color: #1b1a1c;
    }

    .block {
        display: block;
    }

    .boton {
        display: block;
        width: 100%;
        padding: 17px 20px;
        border: 2px solid #000;
        border-radius: 3px;
        background-color: #000;
        color: #fff;
        font-family: "Times New Roman", Times, serif;
        font-size: 18px;
        font-weight: 300;
        line-height: 18px;
        text-align: center;
    }

    .ninos {
        display: flex;
        align-items: center;
        gap: 20px;
        width: 100%;
        padding: 10px;
        border: 2px solid #000;
        font-size: 18px;
        line-height: 21.6px;
        color: #1b1a1c;
    }

    .ninos img {
        width: 90px;
        flex: none;
    }

    @media (max-width: 767px) {
        .lugares {
            border-width: 2px;
        }

        .banda {
            line-height: 24px;
        }

        .titulo {
            font-size: 25px;
            line-height: 25px;
        }

        .pin {
            width: 63px;
            height: 71px;
        }

        .tarjeta {
            flex-direction: column;
            align-items: stretch;
            border-width: 2px;
        }

        .col-foto {
            flex-basis: auto;
        }

        .foto {
            min-height: 200px;
        }

        .subtitulo {
            font-size: 25px;
            line-height: 29px;
            text-align: center;
        }

        .detalle {
            font-size: 16px;
            line-height: 22px;
            text-align: center;
        }

        .boton {
            padding: 15px 20px;
            border-radius: 0;
        }

        .ninos {
            font-size: 16px;
            line-height: 22px;
            text-align: center;
        }

        .ninos img {
            width: 46px;
        }
    }
</style>
