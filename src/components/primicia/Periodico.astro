---
// src/components/primicia/Periodico.astro
// La portada de diario que tapa la invitación al abrirla. El botón la
// desvanece, arranca la música y pide pantalla completa (en iPhone no
// existe y se saltea solo).
import { fecha } from "../../datos/boda";

const lineaFecha = `${fecha.diaSemana}, ${fecha.dia} de ${fecha.mes}, ${fecha.anio}`.toUpperCase();
---

<section id="periodico" class="periodico">
    <div class="titulares">
        <p class="noticia" data-entrada>Noticia de Último momento</p>
        <h1 class="titular" data-entrada>LA BODA DEL AÑO</h1>
    </div>

    <div class="fila-fecha">
        <p class="fecha-diario">{lineaFecha}</p>
    </div>

    <div class="fila-boton">
        <button id="boton-ingresar" class="boton-ingresar" data-entrada type="button">
            Ingresar a mi invitación
        </button>
    </div>
</section>

<style>
    .periodico {
        position: fixed;
        inset: 0;
        z-index: 13;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 20px;
        min-height: 100vh;
        padding: 10px;
        background-color: #fff;
        background-image: linear-gradient(#fff, #fff);
        color: #000;
        text-align: center;
        transition: opacity 2s ease;
    }

    .titulares,
    .fila-fecha,
    .fila-boton {
        width: 100%;
        padding: 0 10px;
    }

    .noticia,
    .titular {
        font-size: 72px;
        line-height: 65px;
        font-weight: 500;
    }

    .noticia {
        font-family: "DSFetteGotisch", serif;
        margin-bottom: 20px;
    }

    .titular {
        font-family: "Rozha One", serif;
        margin-bottom: 20px;
    }

    .fecha-diario {
        max-width: 1140px;
        margin: 0 auto;
        padding: 10px;
        border-top: 2px solid #000;
        border-bottom: 2px solid #000;
        font-family: "Times New Roman", Times, serif;
        font-size: 16px;
        line-height: 27.2px;
    }

    .fila-boton {
        padding-top: 40px;
    }

    .boton-ingresar {
        padding: 17px 40px;
        border: 2px solid #000;
        border-radius: 3px;
        background: transparent;
        color: #000;
        font-family: "Times New Roman", Times, serif;
        font-size: 18px;
        font-weight: 300;
        line-height: 18px;
        cursor: pointer;
    }

    @media (max-width: 767px) {
        .periodico {
            gap: 0;
        }

        .noticia,
        .titular {
            font-size: 27px;
            line-height: 40px;
            margin-bottom: 0;
        }

        .titular {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .fila-fecha {
            padding: 0;
            margin-bottom: 8px;
        }

        .fecha-diario {
            padding: 4px 0 2px;
            border-width: 1px;
            font-size: 13px;
            line-height: 13px;
        }

        .boton-ingresar {
            width: 100%;
            padding: 15px 20px;
            border-radius: 0;
        }
    }
</style>

<script>
    import { reproducir } from "../../scripts/musica";

    const portada = document.getElementById("periodico");
    const boton = document.getElementById("boton-ingresar");

    boton?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "instant" as ScrollBehavior });
        reproducir();

        const raiz = document.documentElement as HTMLElement & {
            webkitRequestFullscreen?: () => void;
        };
        if (raiz.requestFullscreen) raiz.requestFullscreen().catch(() => {});
        else raiz.webkitRequestFullscreen?.();

        document.body.classList.remove("periodico-abierto");
        if (!portada) return;
        portada.style.opacity = "0";
        // Se saca recién cuando terminó de desvanecerse
        setTimeout(() => (portada.style.display = "none"), 2000);
    });
</script>
