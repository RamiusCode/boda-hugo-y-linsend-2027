---
// src/components/primicia/Primicia.astro
// La invitación completa con el diseño "periódico", en orden de arriba a
// abajo. La usan el index (sin pase) y /pase1, /pase2...
import Periodico from "./Periodico.astro";
import Portada from "./Portada.astro";
import Bienvenida from "./Bienvenida.astro";
import FechaContador from "./FechaContador.astro";
import Mensaje from "./Mensaje.astro";
import BotonMusica from "./BotonMusica.astro";
import Padres from "./Padres.astro";
import Itinerario from "./Itinerario.astro";
import Lugares from "./Lugares.astro";
import Cierre from "./Cierre.astro";
import ModalConfirmar from "./ModalConfirmar.astro";
// Tapa la invitación si los novios borraron al invitado del link
import LinkNoDisponible from "../LinkNoDisponible.astro";

export interface Props {
    pases?: number;
}
const { pases = 0 } = Astro.props;
---

<LinkNoDisponible />
<Periodico />
<main>
    <Portada />
    <Bienvenida pases={pases} />
    <FechaContador />
    <Mensaje />
    <BotonMusica />
    <Padres />
    <Itinerario />
    <Lugares />
    <Cierre />
</main>
<ModalConfirmar />

<style is:global>
    /*
       ── Animación de entrada, igual que la plantilla ──────────
       Cada elemento marcado con data-entrada sube desde una altura igual
       a la suya y aparece, por separado, cuando llega a la pantalla (el
       "fadeInUp" de 1,25 s). La plantilla lo hace solo en celular; acá va
       en todas las pantallas, a pedido.

       Se esconden solo si hay JavaScript (la clase la pone el layout):
       sin él, todo queda a la vista.
    */
    .con-js [data-entrada]:not(.entro) {
        visibility: hidden;
    }

    /* --retraso lo usa el itinerario para que sus momentos entren de a uno */
    [data-entrada].entro {
        animation: subir-y-aparecer 1.25s var(--retraso, 0s) both;
    }

    @keyframes subir-y-aparecer {
        from {
            opacity: 0;
            transform: translate3d(0, 100%, 0);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    /*
       ── Íconos animados ───────────────────────────────────────
       Cada ícono tiene un movimiento propio según lo que muestra (los del
       itinerario están en Itinerario.astro). Todos son suaves: hacen su
       gesto, descansan y lo repiten, y el ícono siempre se ve entero.

       icono-sacudir es el del ticket de "Confirmar asistencia": se inclina
       a izquierda y derecha cada vez menos y vuelve a su lugar.
    */
    .icono-sacudir {
        animation: sacudir 4.5s ease-in-out infinite;
        transform-origin: 50% 60%;
    }

    @keyframes sacudir {
        0%,
        45%,
        100% {
            transform: rotate(0);
        }
        9% {
            transform: rotate(-7deg);
        }
        20% {
            transform: rotate(5deg);
        }
        31% {
            transform: rotate(-2.5deg);
        }
        39% {
            transform: rotate(1deg);
        }
    }

    /*
       Novia: flota despacio, como el velo con la brisa. Sube apenas
       inclinándose a un lado, baja, y sube hacia el otro; nunca se frena
       de golpe.
    */
    .anim-novia {
        transform-origin: 50% 100%;
        animation: flotar-novia 6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }

    @keyframes flotar-novia {
        0%,
        50%,
        100% {
            transform: translateY(0) rotate(0);
        }
        25% {
            transform: translateY(-6px) rotate(-3deg);
        }
        75% {
            transform: translateY(-4px) rotate(2.5deg);
        }
    }

    /*
       Novio: una reverencia lenta y elegante. Se inclina, se endereza
       subiendo apenas y descansa. Arranca después que la novia para que
       no se muevan al mismo tiempo.
    */
    .anim-novio {
        transform-origin: 50% 100%;
        animation: reverencia 6s cubic-bezier(0.45, 0, 0.55, 1) 1.5s infinite;
    }

    @keyframes reverencia {
        0%,
        62%,
        100% {
            transform: translateY(0) rotate(0) scale(1);
        }
        24% {
            transform: translateY(2px) rotate(5deg) scale(0.98);
        }
        44% {
            transform: translateY(-3px) rotate(-1deg) scale(1.03);
        }
    }

    /* Vestimenta: se luce, crece apenas con un leve giro y vuelve */
    .anim-vestimenta {
        animation: lucirse 4.5s ease-in-out infinite;
    }

    @keyframes lucirse {
        0%,
        55%,
        100% {
            transform: scale(1) rotate(0);
        }
        20% {
            transform: scale(1.08) rotate(-3deg);
        }
        38% {
            transform: scale(1.04) rotate(2deg);
        }
    }

    /* Pin del mapa: cae sobre el lugar y rebota, como marcándolo */
    .anim-pin {
        transform-origin: 50% 100%;
        animation: marcar-lugar 3.5s ease-in-out infinite;
    }

    @keyframes marcar-lugar {
        0%,
        50%,
        100% {
            transform: translateY(0) scale(1, 1);
        }
        15% {
            transform: translateY(-14px) scale(1, 1);
        }
        27% {
            transform: translateY(0) scale(1.06, 0.94);
        }
        36% {
            transform: translateY(-4px) scale(1, 1);
        }
    }

    /* Sin niños: mueve la cabeza de lado a lado, como diciendo "no" */
    .anim-no-ninos {
        animation: decir-no 4s ease-in-out infinite;
    }

    @keyframes decir-no {
        0%,
        40%,
        100% {
            transform: translateX(0);
        }
        8% {
            transform: translateX(-5px);
        }
        16% {
            transform: translateX(5px);
        }
        24% {
            transform: translateX(-3px);
        }
        32% {
            transform: translateX(2px);
        }
    }

    /* Regalo: salta con ilusión y se sacude un poquito al caer */
    .anim-regalo {
        transform-origin: 50% 100%;
        animation: regalo-ilusion 4s ease-in-out infinite;
    }

    @keyframes regalo-ilusion {
        0%,
        50%,
        100% {
            transform: translateY(0) rotate(0);
        }
        14% {
            transform: translateY(-10px) rotate(-5deg);
        }
        26% {
            transform: translateY(0) rotate(4deg);
        }
        36% {
            transform: translateY(0) rotate(-2deg);
        }
    }
</style>

<script>
    // Cada elemento se anima solo, la primera vez que entra a la pantalla
    const observador = new IntersectionObserver((entradas) => {
        for (const entrada of entradas) {
            if (!entrada.isIntersecting) continue;
            entrada.target.classList.add("entro");
            observador.unobserve(entrada.target);
        }
    });
    document.querySelectorAll("[data-entrada]").forEach((el) => observador.observe(el));
</script>
